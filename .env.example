# Local Docker stack settings. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# docker compose reads .env from here, also when run from the workspace root.
# Every value below is required; compose stops and names a missing one.

# PostgreSQL container (the API containers use the same values). Changing them
# after the first start needs a fresh postgres_data volume.
POSTGRES_USER=liftbig
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=your_db_name

# pgAdmin login (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=your_pgadmin@liftbig.com
PGADMIN_DEFAULT_PASSWORD=examplePassword

# Signs the API's access tokens and email codes. Generate one:
#   openssl rand -base64 48
# Use the same value as liftbig-api/.env to keep tokens valid when switching
# between Docker and npm run start:dev. A new value signs everyone out.
JWT_SECRET=
